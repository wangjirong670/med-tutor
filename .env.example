# 复制成 .env 并填值；.env 不进 git
# 判定/答疑模型（OpenAI 兼容接口；DeepSeek、Moonshot、vLLM 等都行）
MED_TUTOR_API_KEY=
MED_TUTOR_BASE_URL=https://api.openai.com/v1
MED_TUTOR_JUDGE_MODEL=
MED_TUTOR_QA_MODEL=

# 材料整理独立接口（不填则复用 QA/JUDGE_MODEL，不自动 mock）
# MED_TUTOR_STUDY_MODEL=
# MED_TUTOR_STUDY_MAX_TOKENS=10000
# MED_TUTOR_TIMEOUT_MS=120000
# 本机 PDF/图片导入可覆盖默认 bundled Python / PATH Poppler
# MED_STUDY_PYTHON=C:/path/to/python.exe
# MED_STUDY_PDFTOPPM=C:/path/to/pdftoppm.exe

# 可选：个人只读教材根目录（配置后，“选择材料导入”默认打开该目录，程序绝不修改原件）
# MED_TUTOR_TEXTBOOK_ROOT=D:/path/to/your-textbooks

# 兼容旧变量名（二选一即可）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
